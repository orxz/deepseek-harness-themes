{
  "name": "deepseek-harness-themes",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A collection of UI themes for deepseek-harness. One harness. Multiple styles.",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "changeset": "changeset",
    "version:packages": "changeset version",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:packages": "node build/package-smoke.ts",
    "lint": "oxlint packages build vitest.config.ts",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "build": "pnpm -r build",
    "gate": "pnpm typecheck && pnpm build && pnpm test:coverage && pnpm lint && pnpm fmt:check && pnpm smoke:packages",
    "release": "pnpm gate && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-istanbul": "3.2.7",
    "lefthook": "^2.1.10",
    "lightningcss": "^1.33.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4",
    "yaml": "2.9.0"
  }
}

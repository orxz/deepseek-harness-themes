{
  "name": "@dsh-themes/core",
  "version": "0.1.0",
  "description": "Theme definitions and registration helpers for deepseek-harness themes",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orxz/deepseek-harness-themes.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/orxz/deepseek-harness-themes",
  "bugs": "https://github.com/orxz/deepseek-harness-themes/issues",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "theme",
    "ui-theme",
    "plugin"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.client.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}

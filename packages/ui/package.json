{
  "name": "@dshthemes/ui",
  "version": "0.1.2",
  "description": "Theme picker plugin for deepseek-harness themes: registers all themes, adds a settings row, and persists third-party selection",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orxz/deepseek-harness-themes.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/orxz/deepseek-harness-themes",
  "bugs": "https://github.com/orxz/deepseek-harness-themes/issues",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "theme",
    "ui-theme",
    "plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@dshthemes/core": "workspace:^",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@dshthemes/core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.client.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@dshthemes/core": "workspace:^",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "^16.3.2",
    "@tsdown/css": "^0.22.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "19.2.8"
  },
  "dependencies": {
    "clsx": "2.1.1"
  }
}
